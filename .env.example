# ========================================================
# SMART COLLEGE ASSISTANT AI - ENVIRONMENT CONFIGURATION
# ========================================================

# Flask Settings
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-secret-key-for-production
PORT=5000

# Database Configuration
# Local development default: sqlite:///instance/college_assistant.db
# Production (Render/Neon/Supabase PostgreSQL):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# AI Model Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ChromaDB Storage
CHROMA_PERSIST_DIR=instance/chroma_db
UPLOAD_FOLDER=data/uploads
